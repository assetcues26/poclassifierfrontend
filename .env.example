# Copy to .env and adjust if needed.
# Use the SAME host as the browser URL (localhost with localhost).
# Mixing localhost UI + 127.0.0.1 API breaks session cookies (uploads look like logout).
#
# Local: point at the FastAPI server.
# Vercel production: leave empty (Config type) so the browser uses same-origin /api
# and vercel.json rewrites to Render (first-party session cookies for Safari/Mac).
VITE_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=2000
VITE_PAGE_SIZE=50
VITE_APP_TITLE=PO Classifier
