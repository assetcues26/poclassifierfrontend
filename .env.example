# Copy to .env and adjust if needed.
# Use the SAME host as the browser URL (localhost with localhost).
# Mixing localhost UI + 127.0.0.1 API breaks session cookies (uploads look like logout).
VITE_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=2000
VITE_PAGE_SIZE=50
VITE_APP_TITLE=PO Classifier
